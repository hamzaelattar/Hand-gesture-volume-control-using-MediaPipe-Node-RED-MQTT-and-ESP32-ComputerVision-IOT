    {
        "id": "e3c0327e56be9bbf",
        "type": "function",
        "z": "2fa4756690cfeff9",
        "name": "Distance to Volume",
        "func": "\nlet distance = Number(msg.payload);\n\nif (!Number.isFinite(distance)) {\n    return null;\n}\n\n// Seuils de distance\nlet minDistance = 20;\nlet maxDistance = 180;\n\n// Limiter la distance\ndistance = Math.max(minDistance, Math.min(maxDistance, distance));\n\n// Convertir en pourcentage\nlet volume = ((distance - minDistance) /\n              (maxDistance - minDistance)) * 100;\n\n// Arrondir entre 0 et 100\nmsg.payload = Math.round(volume);\n\nreturn msg;\n",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
